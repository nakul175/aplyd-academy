# /etc/academy/academy.env (mode 600, owner root). Real values are never committed.
ACADEMY_ENVIRONMENT=production
ACADEMY_PUBLIC_ORIGIN=https://academy.aplyd.org
ACADEMY_DATABASE_PATH=/var/lib/academy/academy.sqlite
ACADEMY_AUTH_SECRET=generate-with-openssl-rand-base64-48
ACADEMY_MAIL_TRANSPORT=resend
RESEND_API_KEY=re_...
ACADEMY_MAIL_FROM=Aplyd Academy <no-reply@aplyd.org>
# Practice loop (ACA-E2 onwards)
ACADEMY_FILES_PATH=/var/lib/academy/files
# Shared secrets: generate each with openssl rand -base64 48
ACADEMY_JOBS_SECRET=generate-with-openssl-rand-base64-48
ACADEMY_INBOUND_SECRET=generate-with-openssl-rand-base64-48
# AI stays off until AIA-ACADEMY-01 is approved and the evaluation passes (ACA-E7). Model is never defaulted.
ACADEMY_AI_PROVIDER=off
# ACADEMY_AI_MODEL=
# ANTHROPIC_API_KEY=
