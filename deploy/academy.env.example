# /etc/academy/academy.env (mode 600, owner root). Real values are never committed.
ACADEMY_ENVIRONMENT=production
ACADEMY_PUBLIC_ORIGIN=https://academy.aplyd.org
ACADEMY_DATABASE_PATH=/var/lib/academy/academy.sqlite
ACADEMY_AUTH_SECRET=generate-with-openssl-rand-base64-48
ACADEMY_MAIL_TRANSPORT=resend
RESEND_API_KEY=re_...
ACADEMY_MAIL_FROM=Aplyd Academy <no-reply@aplyd.org>
