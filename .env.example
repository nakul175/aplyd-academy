# Aplyd Academy configuration reference. NAMES ONLY. Never put values here or commit a real .env.
# Derived 2026-10-08 from: dist/server/wrangler.json (generated), app/api/partner/links/route.ts,
# scripts/sites-env.mjs, deploy/*.sh, deploy/aplyd-academy.service, scripts/demo/*. See docs/governance/env-config-reference.md.
#
# The application itself needs no environment variable to run. Its only binding is the D1 database "DB"
# (wrangler config), supplied by the runtime, not by this file.

# --- Optional Worker variable (binding), local demo only; loopback URLs only ---
ACADEMY_DUMMY_PARTNER_URL=

# --- Runtime/tooling (set by systemd unit or scripts/sites-env.mjs; defaults exist) ---
SITES_RUNTIME_ROOT=
WRANGLER_SEND_METRICS=
WRANGLER_WRITE_LOGS=
WRANGLER_LOG_PATH=
WRANGLER_REGISTRY_PATH=
MINIFLARE_REGISTRY_PATH=
CLOUDFLARE_CF_FETCH_ENABLED=

# --- Droplet provisioning (deploy/provision.sh; shell variables for one run, not stored in the repo) ---
SAHA_HOST=
SAHA_FIRST_USER=
# Secret: omit to use an SSH deploy key instead. Never commit.
SAHA_GIT_TOKEN=

# --- Local demo proxy and dummy partner (scripts/demo/*) ---
DEMO_UPSTREAM=
DEMO_PORT=
DEMO_HOST=
DEMO_IDENTITIES=
DEMO_SCRIPT=
DEMO_OVERVIEW=
PORT=
HOST=

# --- Local test harnesses (tests/*): point at a LOCAL worker only, never at a hosted URL ---
ACADEMY_URL=
ACADEMY_LOCAL_URL=
ACADEMY_QA_WORKER=
ACADEMY_QA_BUILT=
ACADEMY_QA_CHROME=
ACADEMY_PLAYWRIGHT_MODULE=
